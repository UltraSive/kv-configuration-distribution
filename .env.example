# Every flag can also be set by environment variable (see `kvdist --help`).
# Role: root | replica | proxy
KV_ROLE=root
KV_DATA_DIR=./data
KV_HTTP_ADDR=0.0.0.0:8080
KV_PEER_ADDR=0.0.0.0:7070
# Optional local Unix sockets: postcard (kvctl) and HTTP
# KV_SOCKET=/run/kvdist.sock
# KV_HTTP_SOCKET=/run/kvdist-http.sock
# TLS: cert/key enable HTTPS; adding the CA enables peer mutual TLS
# KV_TLS_CERT=/etc/kvdist/node.crt
# KV_TLS_KEY=/etc/kvdist/node.key
# KV_TLS_CA=/etc/kvdist/ca.crt
# Bearer tokens for the HTTP API (`<read|write> <token>` lines)
# KV_AUTH_TOKENS=/etc/kvdist/tokens
# With KV_TLS_CA: peers that may forward writes, by certificate name (none: no peer)
# KV_PEER_WRITERS=deploy-1.internal
# Followers: take a new snapshot when the upstream's database or log differs
# KV_RESYNC=true

# Replica/proxy: upstreams to replicate from, in preference order
# KV_UPSTREAMS=root-a:7070,root-b:7070
# Proxy: replicas to fetch cache misses from (defaults to KV_UPSTREAMS)
# KV_REPLICAS=replica-1:7070
# KV_LOG_RETENTION=1000000
# KV_HISTORY_WINDOW=100000
# KV_PROXY_WINDOW=10000
# Proxy cache: evict above the soft limit, stop caching misses at the hard limit
# KV_PROXY_SOFT_LIMIT=1GiB
# KV_PROXY_HARD_LIMIT=2GiB
# Same, triggered by free space on the data disk (0 = off)
# KV_PROXY_DISK_SOFT_FREE=10GiB
# KV_PROXY_DISK_HARD_FREE=2GiB
